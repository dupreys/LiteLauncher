<Window x:Class="LiteLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiteLauncher" Width="1280" Height="720" MinWidth="800" MinHeight="450"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown" PreviewTextInput="OnPreviewTextInput"
        PreviewMouseRightButtonUp="OnPreviewRightClick">

    <Window.Resources>
        <!-- Library grid card. Lives here (not in Styles.xaml) because it wires code-behind handlers. -->
        <Style x:Key="CardContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="166"/>
            <Setter Property="Height" Value="249"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <EventSetter Event="GotKeyboardFocus" Handler="OnCardGotFocus"/>
            <EventSetter Event="MouseDoubleClick" Handler="OnCardDoubleClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" CornerRadius="3" BorderThickness="3" BorderBrush="Transparent"
                                Background="{DynamicResource Surface}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cover only (small home tiles) -->
        <DataTemplate x:Key="ArtOnly">
            <Grid>
                <TextBlock Text="{Binding Initial}" FontSize="44" FontWeight="Bold"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
            </Grid>
        </DataTemplate>

        <!-- Cover with the game name (hero tile and library cards) -->
        <DataTemplate x:Key="ArtNamed">
            <Grid>
                <TextBlock Text="{Binding Initial}" FontSize="64" FontWeight="Bold"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                <TextBlock Text="★" FontSize="22" Foreground="#F5C518" Margin="0,6,10,0"
                           HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                    </TextBlock.Effect>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border VerticalAlignment="Bottom" Padding="12,22,12,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#D9000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ===== Backdrop: game art cross-fades behind everything ===== -->
        <Image x:Name="BackdropA" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"/>
        <Image x:Name="BackdropB" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"/>
        <Rectangle x:Name="DimOverlay" Fill="Black" Opacity="0.35" IsHitTestVisible="False"/>
        <Rectangle x:Name="BottomShade" IsHitTestVisible="False" Opacity="0.92">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0.45"/>
                    <GradientStop Color="{DynamicResource BgColor}" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- Soft shadow in the corners, like the Xbox home -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.78" RadiusY="0.78">
                    <GradientStop Color="#00000000" Offset="0.5"/>
                    <GradientStop Color="#AA000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Everything below is laid out on a 1280x720 canvas and scaled to the window -->
        <Viewbox Stretch="Uniform">
            <Grid Width="1280" Height="720">

                <!-- ===== Top bar (all screens) ===== -->
                <Grid x:Name="TopBar" VerticalAlignment="Top" Margin="78,34,70,0" Height="60" GotKeyboardFocus="OnTopBarGotFocus">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Grid Width="44" Height="44" VerticalAlignment="Top" Margin="0,0,14,0">
                            <Ellipse Fill="{DynamicResource SurfaceHi}"/>
                            <TextBlock x:Name="AvatarInitial" Text="G" FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PersonaText" Text="Guest" FontSize="18" FontWeight="SemiBold"/>
                                <Border x:Name="SteamBadge" Background="White" Margin="8,3,0,0" Padding="4,0"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="STEAM" Foreground="Black" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SubText" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" KeyboardNavigation.DirectionalNavigation="Contained">
                        <!-- Game running with the overlay tucked away: D-pad Up from the top row, then A brings the overlay back -->
                        <Button x:Name="NowPlayingChip" Style="{StaticResource IconButton}" Width="Auto" MinWidth="40" Margin="0,0,10,0"
                                Visibility="Collapsed" Click="OnNowPlayingClick">
                            <StackPanel Orientation="Horizontal" Margin="14,0,16,0">
                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Accent}"/>
                                <TextBlock x:Name="NowPlayingText" FontSize="14" Margin="10,0,0,0" MaxWidth="240" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Network: Wi-Fi, Ethernet or offline -->
                        <Button x:Name="NetworkButton" Style="{StaticResource IconButton}" Margin="0,0,6,0" Click="OnNetworkClick">
                            <Grid x:Name="NetworkIcon" Width="24" Height="24">
                                <Path x:Name="NetWifi" Stretch="None" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M2,9 A14,14 0 0 1 22,9 M5,12.5 A10,10 0 0 1 19,12.5 M8.5,16 A5.5,5.5 0 0 1 15.5,16 M12,19.5 L12.01,19.5"/>
                                <Path x:Name="NetEthernet" Stretch="None" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                                      Data="M5,4 H19 V13 H15 V17 H9 V13 H5 Z M9,7 V10 M12,7 V10 M15,7 V10"/>
                                <Path x:Name="NetNone" Stretch="None" Stroke="{DynamicResource TextMuted}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                                      Data="M2,9 A14,14 0 0 1 22,9 M5,12.5 A10,10 0 0 1 19,12.5 M8.5,16 A5.5,5.5 0 0 1 15.5,16 M12,19.5 L12.01,19.5 M3,3 L21,21"/>
                            </Grid>
                        </Button>
                        <Button x:Name="VolumeButton" Style="{StaticResource IconButton}" Margin="0,0,10,0" Click="OnVolumeClick">
                            <Grid x:Name="VolumeIcon" Width="24" Height="24">
                                <Path Stretch="None" Fill="{DynamicResource TextPrimary}" Data="M3,9 H7 L12,5 V19 L7,15 H3 Z"/>
                                <Path x:Name="VolWaves" Stretch="None" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M15.5,9 A4,4 0 0 1 15.5,15 M18,6.5 A8,8 0 0 1 18,17.5"/>
                                <Path x:Name="VolMuted" Stretch="None" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Data="M16,9 L21,15 M21,9 L16,15"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,14,0" Visibility="Collapsed">
                            <Border Width="26" Height="13" BorderBrush="White" BorderThickness="1.5" CornerRadius="2">
                                <Border x:Name="BatteryFill" Background="White" HorizontalAlignment="Left"
                                        Margin="1.5" Width="20" CornerRadius="1"/>
                            </Border>
                            <Border Width="2" Height="6" Background="White" Margin="1,0,0,0" CornerRadius="0,1,1,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ClockText" FontSize="17" VerticalAlignment="Center"/>
                        <Button x:Name="PowerButton" Style="{StaticResource IconButton}" Margin="12,0,0,0"
                                Click="OnPowerClick" ToolTip="Power  (Select / F9)">
                            <Grid Width="24" Height="24">
                                <Path Stretch="None" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,3 V11 M6.5,6.5 A8,8 0 1 0 17.5,6.5"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===== HOME ===== -->
                <Canvas x:Name="HomeView">
                    <!-- Last played, big -->
                    <Button x:Name="HeroTile" Canvas.Left="66" Canvas.Top="170" Width="262" Height="262"
                            Style="{StaticResource Tile}" ContentTemplate="{StaticResource ArtNamed}"
                            Click="OnGameTileClick"/>

                    <!-- Next recent games -->
                    <ItemsControl x:Name="RecentList" Canvas.Left="357" Canvas.Top="293" Focusable="False" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="134" Height="134" Margin="0,0,9,0" Style="{StaticResource Tile}"
                                        Content="{Binding}" ContentTemplate="{StaticResource ArtOnly}"
                                        Click="OnGameTileClick"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyText" Canvas.Left="357" Canvas.Top="330" FontSize="20"
                               Foreground="{DynamicResource TextMuted}" Visibility="Collapsed"/>

                    <!-- Bottom row -->
                    <Button x:Name="LibraryTile" Canvas.Left="70" Canvas.Top="462" Width="252" Height="142"
                            Style="{StaticResource Tile}" Click="OnOpenLibrary">
                        <Grid>
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="38"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,26"/>
                            <TextBlock Text="My games &amp; apps" FontSize="16" Margin="16,0,0,14"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Button>

                    <Button x:Name="SteamTile" Canvas.Left="357" Canvas.Top="462" Width="278" Height="142"
                            Style="{StaticResource Tile}" Click="OnLaunchersTileClick">
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource BgColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                            <StackPanel Margin="16,0,16,14" VerticalAlignment="Bottom">
                                <TextBlock Text="Launchers" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="Open Steam or Epic Games" FontSize="14" Opacity="0.85"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="SettingsTile" Canvas.Left="645" Canvas.Top="462" Width="278" Height="142"
                            Style="{StaticResource Tile}" Click="OnOpenSettings">
                        <Grid>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="38"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,26"/>
                            <StackPanel Margin="16,0,16,14" VerticalAlignment="Bottom">
                                <TextBlock Text="Settings" FontSize="16"/>
                                <TextBlock Text="Sound, theme, Steam account" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="FriendsTile" Canvas.Left="933" Canvas.Top="462" Width="278" Height="142"
                            Style="{StaticResource Tile}" Click="OnFriendsTileClick">
                        <Grid Margin="16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Grid Width="56" Height="56">
                                    <Ellipse Fill="{DynamicResource Accent}"/>
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="FriendsTileAvatars" Margin="10,12,0,0" Focusable="False" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="32" Height="32" Margin="0,0,-8,0" Stroke="{DynamicResource Surface}" StrokeThickness="2">
                                                <Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/></Ellipse.Fill>
                                            </Ellipse>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Friends" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FriendsTileSub" Text="Steam friends online" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Text nav, bottom-left like the Xbox dashboard -->
                    <StackPanel Canvas.Left="66" Canvas.Top="636" Orientation="Horizontal">
                        <Button x:Name="NavStore" Content="Store" Style="{StaticResource TextNav}" Click="OnOpenStore"/>
                        <Button x:Name="NavCommunity" Content="Community" Style="{StaticResource TextNav}" Click="OnOpenCommunity"/>
                        <Button x:Name="NavExit" Content="Exit" Style="{StaticResource TextNav}" Click="OnExit"/>
                    </StackPanel>
                </Canvas>

                <!-- ===== LIBRARY ===== -->
                <Grid x:Name="LibraryView" Margin="70,110,70,64" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="My games &amp; apps" FontSize="28" FontWeight="Light" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CountText" Margin="16,8,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="340">
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                                     ToolTip="Search installed games (Ctrl+F)" TextChanged="OnSearchChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0"/>
                            <TextBlock x:Name="SearchHint" Text="Search installed games" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextMuted}" FontSize="16"
                                       VerticalAlignment="Center" Margin="40,0,12,0"/>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="FilterBar" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14"/>

                    <ListBox x:Name="GameGrid" Grid.Row="2" Focusable="False" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource CardContainer}"
                             ItemTemplate="{StaticResource ArtNamed}"
                             SelectionMode="Single"
                             KeyboardNavigation.DirectionalNavigation="Contained"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <TextBlock x:Name="NoResultsText" Grid.Row="2" Visibility="Collapsed" FontSize="20"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,40,0,0"/>
                </Grid>

                <!-- ===== SETTINGS ===== -->
                <Grid x:Name="SettingsView" Margin="70,110,70,64" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Settings" FontSize="28" FontWeight="Light" Margin="0,0,0,14"/>
                        <Button x:Name="MenuSound" Content="Sound" Tag="Sound" Style="{StaticResource SideNav}"
                                GotKeyboardFocus="OnSideMenuFocus" Click="OnSideMenuClick"/>
                        <Button x:Name="MenuTheme" Content="Theme" Tag="Theme" Style="{StaticResource SideNav}"
                                GotKeyboardFocus="OnSideMenuFocus" Click="OnSideMenuClick"/>
                        <Button x:Name="MenuProfile" Content="Profile" Tag="Profile" Style="{StaticResource SideNav}"
                                GotKeyboardFocus="OnSideMenuFocus" Click="OnSideMenuClick"/>
                        <Button x:Name="MenuAccount" Content="Steam account" Tag="Account" Style="{StaticResource SideNav}"
                                GotKeyboardFocus="OnSideMenuFocus" Click="OnSideMenuClick"/>
                        <Button x:Name="MenuIntegrations" Content="Integrations" Tag="Integrations" Style="{StaticResource SideNav}"
                                GotKeyboardFocus="OnSideMenuFocus" Click="OnSideMenuClick"/>
                        <Button x:Name="MenuGeneral" Content="General" Tag="General" Style="{StaticResource SideNav}"
                                GotKeyboardFocus="OnSideMenuFocus" Click="OnSideMenuClick"/>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#99000000" CornerRadius="4" Padding="32,24,14,24">
                        <!-- Long panels (Profile, Integrations) scroll; keyboard/gamepad focus scrolls them into view. -->
                        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Hidden" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,18,0">
                        <Grid>
                            <!-- Sound -->
                            <StackPanel x:Name="PanelSound">
                                <TextBlock Text="Sound" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="System volume" Style="{StaticResource FieldLabel}" Margin="0,4,0,8"/>
                                <DockPanel>
                                    <TextBlock x:Name="SysVolText" DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                    <Slider x:Name="SysVolumeSlider" Style="{StaticResource XSlider}"
                                            ValueChanged="OnSliderChanged"/>
                                </DockPanel>
                                <ToggleButton x:Name="MuteToggle" Content="Mute system sound" Style="{StaticResource XToggle}"
                                              Checked="OnToggleChanged" Unchecked="OnToggleChanged"/>

                                <TextBlock Text="Launcher sounds" Style="{StaticResource FieldLabel}" Margin="0,26,0,0"/>
                                <ToggleButton x:Name="UiSoundsToggle" Content="Navigation sounds" Style="{StaticResource XToggle}"
                                              Checked="OnToggleChanged" Unchecked="OnToggleChanged"/>
                                <TextBlock Text="Navigation volume" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <TextBlock x:Name="UiVolText" DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                    <Slider x:Name="UiVolumeSlider" Style="{StaticResource XSlider}"
                                            ValueChanged="OnSliderChanged"/>
                                </DockPanel>
                            </StackPanel>

                            <!-- Theme -->
                            <StackPanel x:Name="PanelTheme" Visibility="Collapsed">
                                <TextBlock Text="Theme" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="Accent colour" Style="{StaticResource FieldLabel}" Margin="0,4,0,8"/>
                                <WrapPanel x:Name="AccentSwatches"/>

                                <TextBlock Text="Background colour" Style="{StaticResource FieldLabel}" Margin="0,10,0,8"/>
                                <WrapPanel x:Name="BackgroundSwatches"/>

                                <ToggleButton x:Name="ShowBackdropToggle" Content="Show game art in the background"
                                              Style="{StaticResource XToggle}" Margin="0,16,0,0"
                                              Checked="OnToggleChanged" Unchecked="OnToggleChanged"/>
                                <ToggleButton x:Name="FullBackdropToggle" Content="Wallpaper over the whole screen (Xbox style)"
                                              Style="{StaticResource XToggle}" Margin="0,8,0,0"
                                              Checked="OnToggleChanged" Unchecked="OnToggleChanged"/>
                                <ToggleButton x:Name="FitBackdropToggle" Content="Bottom fade style: show the whole image (no cropping)"
                                              Style="{StaticResource XToggle}" Margin="0,8,0,0"
                                              Checked="OnToggleChanged" Unchecked="OnToggleChanged"/>
                                <TextBlock Text="Background darkness" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <TextBlock x:Name="DimText" DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                    <Slider x:Name="DimSlider" Style="{StaticResource XSlider}" Maximum="90"
                                            ValueChanged="OnSliderChanged"/>
                                </DockPanel>
                            </StackPanel>

                            <!-- Profile -->
                            <StackPanel x:Name="PanelProfile" Visibility="Collapsed">
                                <TextBlock Text="Profile" Style="{StaticResource SectionTitle}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Grid Width="80" Height="80" Margin="0,0,22,0">
                                        <Ellipse Fill="{DynamicResource SurfaceHi}"/>
                                        <TextBlock x:Name="ProfileAvatarInitial" Text="G" FontSize="38" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="ProfileAvatarBrush" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ProfileNamePreview" FontSize="24" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ProfileSubText" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Display name" Style="{StaticResource FieldLabel}"/>
                                <Grid Width="360" HorizontalAlignment="Left">
                                    <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" MaxLength="24"
                                             TextChanged="OnNameChanged"/>
                                    <TextBlock x:Name="NameHint" Text="Your name" IsHitTestVisible="False"
                                               Foreground="{DynamicResource TextMuted}" FontSize="16"
                                               VerticalAlignment="Center" Margin="15,0,12,0"/>
                                </Grid>

                                <TextBlock Text="Ready-made avatars" Style="{StaticResource FieldLabel}"/>
                                <WrapPanel x:Name="PresetAvatarPanel" MaxWidth="600" HorizontalAlignment="Left"/>

                                <TextBlock Text="Picture" Style="{StaticResource FieldLabel}"/>
                                <Button x:Name="ChoosePictureButton" Style="{StaticResource ActionButton}" Margin="0"
                                        Click="OnChoosePictureClick">
                                    <TextBlock Text="Choose a picture…"/>
                                </Button>
                                <Button x:Name="RemovePictureButton" Style="{StaticResource ActionButton}"
                                        Click="OnRemovePictureClick">
                                    <TextBlock Text="Remove custom picture"/>
                                </Button>

                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,20,0,0"
                                           Foreground="{DynamicResource TextMuted}"
                                           Text="Your name and picture are only used inside LiteLauncher. Your Steam profile is not changed. Leave the name empty to use your Steam name."/>
                            </StackPanel>

                            <!-- Steam account -->
                            <StackPanel x:Name="PanelAccount" Visibility="Collapsed">
                                <TextBlock Text="Steam account" Style="{StaticResource SectionTitle}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Grid Width="72" Height="72" Margin="0,0,18,0">
                                        <Ellipse Fill="{DynamicResource SurfaceHi}"/>
                                        <TextBlock x:Name="PanelAvatarInitial" Text="G" FontSize="30" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="PanelAvatarBrush" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="AccountName" FontSize="22" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AccountId" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="AccountStatus" TextWrapping="Wrap" Margin="0,18,0,6"
                                           Foreground="{DynamicResource TextMuted}"/>

                                <Button x:Name="SignInButton" Style="{StaticResource ActionButton}" Click="OnSignInClick">
                                    <TextBlock x:Name="SignInLabel" Text="Sign in with Steam"/>
                                </Button>
                                <Button x:Name="DetectButton" Style="{StaticResource ActionButton}" Click="OnDetectClick">
                                    <TextBlock Text="Use the account signed in to the Steam client"/>
                                </Button>
                                <Button x:Name="SignOutButton" Style="{StaticResource ActionButton}" Click="OnSignOutClick">
                                    <TextBlock Text="Sign out"/>
                                </Button>

                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,20,0,0"
                                           Foreground="{DynamicResource TextMuted}"
                                           Text="Sign-in happens on steamcommunity.com in your browser. LiteLauncher only receives your public Steam ID and never sees your password."/>
                            </StackPanel>

                            <!-- General -->
                            <StackPanel x:Name="PanelIntegrations" Visibility="Collapsed">
                                <TextBlock Text="Integrations" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Steam Web API key (friends list)" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="SteamApiKeyBox" Style="{StaticResource FieldBox}" Width="380"
                                             TextChanged="OnApiKeyChanged"/>
                                    <Button Style="{StaticResource ActionButton}" Margin="10,0,0,0" Tag="https://steamcommunity.com/dev/apikey"
                                            Click="OnOpenLinkClick"><TextBlock Text="Get a key…"/></Button>
                                </StackPanel>
                                <TextBlock Text="SteamGridDB API key (covers, backgrounds, logos)" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="GridDbKeyBox" Style="{StaticResource FieldBox}" Width="380"
                                             TextChanged="OnApiKeyChanged"/>
                                    <Button Style="{StaticResource ActionButton}" Margin="10,0,0,0" Tag="https://www.steamgriddb.com/profile/preferences/api"
                                            Click="OnOpenLinkClick"><TextBlock Text="Get a key…"/></Button>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,20,0,0" Foreground="{DynamicResource TextMuted}"
                                           Text="Both keys are free. They are saved only on this PC (settings.json) and sent only to Steam and SteamGridDB. The friends list also needs you to be signed in with Steam."/>
                            </StackPanel>

                            <StackPanel x:Name="PanelGeneral" Visibility="Collapsed">
                                <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                                <ToggleButton x:Name="FullscreenToggle" Content="Start in fullscreen"
                                              Style="{StaticResource XToggle}" Margin="0,4,0,0"
                                              Checked="OnToggleChanged" Unchecked="OnToggleChanged"/>
                                <ToggleButton x:Name="StartWithWindowsToggle" Content="Start with Windows"
                                              Style="{StaticResource XToggle}" Margin="0,8,0,0"
                                              Checked="OnToggleChanged" Unchecked="OnToggleChanged"/>
                                <ToggleButton x:Name="UpdateCheckToggle" Content="Check for updates at startup"
                                              Style="{StaticResource XToggle}" Margin="0,8,0,0"
                                              Checked="OnToggleChanged" Unchecked="OnToggleChanged"/>
                                <Button x:Name="UpdateButton" Style="{StaticResource ActionButton}" Click="OnUpdateButtonClick">
                                    <TextBlock x:Name="UpdateLabel" Text="Check for updates now"/>
                                </Button>
                                <Button x:Name="LanguageButton" Style="{StaticResource ActionButton}" Click="OnLanguageClick">
                                    <TextBlock x:Name="LanguageLabel"/>
                                </Button>
                                <Button x:Name="RescanButton" Style="{StaticResource ActionButton}" Click="OnRescanClick">
                                    <TextBlock Text="Rescan game library"/>
                                </Button>
                                <TextBlock x:Name="VersionText" Margin="0,26,0,0" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== Button hints (bottom-right) ===== -->
                <StackPanel x:Name="HintBar" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom" Margin="0,0,70,26"/>

                <!-- ===== Game menu (Start on a game): details, Play, store page, Manage ===== -->
                <Grid x:Name="GameDetails" Visibility="Collapsed"
                      KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle">
                    <Rectangle Fill="#B3000000" MouseLeftButtonUp="OnDetailsDimClick"/>
                    <Border Background="{DynamicResource Bg}" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="DetailsBackdrop" Stretch="UniformToFill" Opacity="0.55" IsHitTestVisible="False"/>
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F2000000" Offset="0"/>
                                        <GradientStop Color="#99000000" Offset="0.55"/>
                                        <GradientStop Color="#33000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Grid Margin="72,64,72,44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="340"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Left: what the store says about the game -->
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock x:Name="DetailsSource" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource Accent}" Margin="0,0,0,14"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="130" Height="195" ClipToBounds="True"
                                                Background="{DynamicResource Surface}" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock x:Name="DetailsInitial" FontSize="44" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image x:Name="DetailsCover" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="26,0,0,0" VerticalAlignment="Center" MaxWidth="560">
                                            <Image x:Name="DetailsLogo" MaxHeight="96" MaxWidth="420" HorizontalAlignment="Left"
                                                   Stretch="Uniform" Visibility="Collapsed"/>
                                            <TextBlock x:Name="DetailsTitle" FontSize="42" FontWeight="Light" TextWrapping="Wrap"/>
                                            <Border HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,3"
                                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                                                <TextBlock Text="Installed" FontSize="12" Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="DetailsMeta" Margin="0,22,0,0" FontSize="14" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="DetailsGenres" Margin="0,6,0,0" FontSize="14"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="DetailsDescription" Margin="0,16,0,0" FontSize="15" TextWrapping="Wrap"
                                               LineHeight="22" MaxWidth="600" HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- Right: your numbers -->
                                <StackPanel Grid.Column="1" Margin="0,40,0,0">
                                    <Border Style="{StaticResource XboxCard}">
                                        <StackPanel>
                                            <TextBlock Text="YOUR PLAYTIME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                            <TextBlock x:Name="DetailsPlaytime" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource XboxCard}">
                                        <StackPanel>
                                            <TextBlock Text="ACHIEVEMENTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                            <TextBlock x:Name="DetailsAchievements" Text="Loading…" FontSize="16" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <Grid x:Name="AchievementsBar" Height="6" Margin="0,10,0,0" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="AchievementsFill" Width="0*"/>
                                                    <ColumnDefinition x:Name="AchievementsRest" Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="2" Background="#33FFFFFF"/>
                                                <Border Grid.Column="0" Background="{DynamicResource Accent}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource XboxCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="LAST PLAYED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                                <TextBlock x:Name="DetailsLastPlayed" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="SIZE ON DISK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                                <TextBlock x:Name="DetailsSize" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Manage: rename, cover, background -->
                                <Border x:Name="ManagePanel" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed"
                                        Style="{StaticResource XboxCard}" HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Game name" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Grid Width="360">
                                                <TextBox x:Name="GameNameBox" Style="{StaticResource FieldBox}" MaxLength="80"
                                                         TextChanged="OnGameNameChanged"/>
                                                <TextBlock x:Name="GameNameHint" IsHitTestVisible="False" FontSize="16"
                                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="15,0,12,0"/>
                                            </Grid>
                                            <Button Style="{StaticResource XboxButton}" Margin="10,0,0,0" Click="OnSaveGameNameClick">
                                                <TextBlock Text="Save name"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Style="{StaticResource XboxButton}" Margin="0,10,10,0" Click="OnChangeCoverClick">
                                                <TextBlock Text="Change cover…"/>
                                            </Button>
                                            <Button Style="{StaticResource XboxButton}" Margin="0,10,10,0" Click="OnChangeBackgroundClick">
                                                <TextBlock Text="Change background…"/>
                                            </Button>
                                            <Button Style="{StaticResource XboxButton}" Margin="0,10,10,0" Click="OnGridDbClick">
                                                <TextBlock Text="SteamGridDB…"/>
                                            </Button>
                                            <Button x:Name="ResetGameButton" Style="{StaticResource XboxButton}" Margin="0,10,0,0"
                                                    Click="OnResetGameClick">
                                                <TextBlock Text="Restore original"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Actions -->
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <Button x:Name="DetailsPlayButton" Style="{StaticResource XboxPrimary}" Width="230" Height="50"
                                            Click="OnDetailsPlayClick">
                                        <TextBlock Text="▶  Play"/>
                                    </Button>
                                    <Button x:Name="DetailsStoreButton" Style="{StaticResource XboxButton}" Width="230" Height="50"
                                            Margin="12,0,0,0" Click="OnDetailsStoreClick">
                                        <TextBlock Text="More about the game"/>
                                    </Button>
                                    <Button x:Name="DetailsAchievementsButton" Style="{StaticResource XboxButton}" Width="200" Height="50"
                                            Margin="12,0,0,0" Click="OnDetailsAchievementsClick">
                                        <TextBlock Text="Achievements"/>
                                    </Button>
                                    <Button x:Name="DetailsManageButton" Style="{StaticResource XboxButton}" Width="230" Height="50"
                                            Margin="12,0,0,0" Click="OnDetailsManageClick">
                                        <TextBlock x:Name="DetailsManageLabel" Text="Manage   ▾"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- SteamGridDB picker (covers / backgrounds / logos) -->
                            <Border x:Name="GridDbPanel" Visibility="Collapsed" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle" Background="{DynamicResource Bg}" Padding="72,56,72,40">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="STEAMGRIDDB" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button x:Name="GridTabCover" Style="{StaticResource XboxButton}" Height="52" Padding="20,6" Width="170"
                                                    Tag="Cover" Click="OnGridTabClick"><TextBlock Text="Covers"/></Button>
                                            <Button x:Name="GridTabBackground" Style="{StaticResource XboxButton}" Height="52" Padding="20,6" Width="170"
                                                    Margin="10,0,0,0" Tag="Background" Click="OnGridTabClick"><TextBlock Text="Backgrounds"/></Button>
                                            <Button x:Name="GridTabLogo" Style="{StaticResource XboxButton}" Height="52" Padding="20,6" Width="170"
                                                    Margin="10,0,0,0" Tag="Logo" Click="OnGridTabClick"><TextBlock Text="Logos"/></Button>
                                            <Button Style="{StaticResource XboxButton}" Height="52" Padding="20,6" Width="120"
                                                    Margin="10,0,0,0" Click="OnGridCloseClick"><TextBlock Text="Back"/></Button>
                                        </StackPanel>
                                        <TextBlock x:Name="GridStatus" Margin="0,14,0,14" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                    <ScrollViewer x:Name="GridScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
                                        <WrapPanel x:Name="GridResults" Margin="10,12,10,12"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Achievements list (Steam) -->
                            <Border x:Name="AchievementsPanel" Visibility="Collapsed" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle" Background="{DynamicResource Bg}" Padding="72,56,72,40">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="ACHIEVEMENTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                        <TextBlock x:Name="AchievementsTitle" FontSize="34" FontWeight="Light" Margin="0,4,60,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="AchievementsSummary" FontSize="14" Margin="0,4,0,10"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <Grid Height="6" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="AchievementsListFill" Width="0*"/>
                                                <ColumnDefinition x:Name="AchievementsListRest" Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" Background="#33FFFFFF"/>
                                            <Border Grid.Column="0" Background="{DynamicResource Accent}"/>
                                        </Grid>
                                        <Button x:Name="AchievementsBackButton" Style="{StaticResource XboxButton}" Height="52" Padding="20,6" Width="120"
                                                HorizontalAlignment="Left" Click="OnAchievementsCloseClick">
                                            <TextBlock Text="Back"/>
                                        </Button>
                                    </StackPanel>
                                    <ScrollViewer x:Name="AchievementsScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
                                        <StackPanel x:Name="AchievementsList" Margin="0,0,0,6"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Button x:Name="DetailsCloseButton" Style="{StaticResource XboxButton}" Width="44" Height="44"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0"
                                    Padding="0" HorizontalContentAlignment="Center" Click="OnDetailsCloseClick" ToolTip="Close">
                                <Path Stretch="None" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0,0 L12,12 M12,0 L0,12"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== Friends (Steam): who is online, A opens a Steam chat with them ===== -->
                <Grid x:Name="FriendsPanel" Visibility="Collapsed"
                      KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle">
                    <Rectangle Fill="#B3000000" MouseLeftButtonUp="OnFriendsDimClick"/>
                    <Border Width="470" HorizontalAlignment="Right" Background="{DynamicResource Bg}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0" Padding="32,44,32,32">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="STEAM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                <TextBlock Text="Friends online" FontSize="36" FontWeight="Light" Margin="0,4,0,0"/>
                                <TextBlock x:Name="FriendsStatus" FontSize="13" Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap" Margin="0,4,0,14"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
                                <ItemsControl x:Name="FriendsList" Focusable="False" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource XboxRow}" Height="68" Margin="0,0,0,8" Padding="10,0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Click="OnFriendClick" Tag="{Binding SteamId}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="46" Height="46" VerticalAlignment="Center">
                                                        <Rectangle Fill="{DynamicResource SurfaceHi}"/>
                                                        <Rectangle><Rectangle.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle>
                                                        <Rectangle Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                   Fill="{Binding StatusBrush}" Stroke="{DynamicResource Bg}" StrokeThickness="2" Margin="0,0,-3,-3"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{Binding StatusBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="FriendsChatButton" Style="{StaticResource XboxPrimary}" Height="46" Width="190"
                                        Click="OnOpenSteamChatClick">
                                    <TextBlock Text="Open Steam chat"/>
                                </Button>
                                <Button x:Name="FriendsSetupButton" Style="{StaticResource XboxButton}" Height="46" Width="190"
                                        Margin="12,0,0,0" Click="OnFriendsSetupClick">
                                    <TextBlock x:Name="FriendsSetupLabel" Text="Refresh"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== Launchers: open Steam or the Epic Games Launcher ===== -->
                <Grid x:Name="LaunchersPanel" Visibility="Collapsed"
                      KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle">
                    <Rectangle Fill="#B3000000" MouseLeftButtonUp="OnLaunchersDimClick"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Open a launcher" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="B to go back" FontSize="13" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,6,0,24"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LauncherSteamButton" Style="{StaticResource Tile}" Width="300" Height="180"
                                    Click="OnOpenSteamLauncher">
                                <Grid>
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1B2838" Offset="0"/>
                                            <GradientStop Color="#2A475E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                    <StackPanel Margin="20,0,20,18" VerticalAlignment="Bottom">
                                        <TextBlock Text="Steam" FontSize="28" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LauncherSteamSub" FontSize="14" Opacity="0.85"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="LauncherEpicButton" Style="{StaticResource Tile}" Width="300" Height="180"
                                    Margin="20,0,0,0" Click="OnOpenEpicLauncher">
                                <Grid>
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#202020" Offset="0"/>
                                            <GradientStop Color="#0078F2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                    <StackPanel Margin="20,0,20,18" VerticalAlignment="Bottom">
                                        <TextBlock Text="Epic Games" FontSize="28" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LauncherEpicSub" FontSize="14" Opacity="0.85"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== Toast ===== -->
                <Border x:Name="ToastBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,76"
                        Background="{DynamicResource SurfaceHi}" CornerRadius="4" Padding="22,11"
                        Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" FontSize="15"/>
                </Border>

                <!-- ===== Quick settings: volume and Wi-Fi (opened from the top-bar icons) ===== -->
                <Grid x:Name="QuickPanel" Visibility="Collapsed"
                      KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
                    <Rectangle Fill="#66000000" MouseLeftButtonUp="OnQuickDimClick"/>
                    <Border Width="440" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0"
                            Padding="32,96,32,32">
                        <Grid>
                            <!-- Volume -->
                            <StackPanel x:Name="VolumePanel" Visibility="Collapsed">
                                <TextBlock Text="Volume" FontSize="34" FontWeight="Light"/>
                                <TextBlock Text="Left / Right changes the system volume." FontSize="13" Margin="0,4,0,16"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <DockPanel>
                                    <TextBlock x:Name="QuickVolText" DockPanel.Dock="Right" Width="52" TextAlignment="Right"
                                               VerticalAlignment="Center" FontSize="16"/>
                                    <Slider x:Name="QuickVolumeSlider" Style="{StaticResource XSlider}"
                                            ValueChanged="OnQuickVolumeChanged"/>
                                </DockPanel>
                                <ToggleButton x:Name="QuickMuteToggle" Content="Mute system sound" Style="{StaticResource XToggle}"
                                              Checked="OnQuickMuteChanged" Unchecked="OnQuickMuteChanged"/>
                            </StackPanel>

                            <!-- Wi-Fi -->
                            <StackPanel x:Name="WifiPanel" Visibility="Collapsed">
                                <TextBlock Text="Network" FontSize="34" FontWeight="Light"/>
                                <TextBlock x:Name="WifiStatus" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,14"
                                           Foreground="{DynamicResource TextMuted}"/>

                                <StackPanel x:Name="WifiListPanel">
                                    <ScrollViewer x:Name="WifiScroll" MaxHeight="300" VerticalScrollBarVisibility="Hidden" Focusable="False">
                                        <StackPanel x:Name="WifiList"/>
                                    </ScrollViewer>
                                    <Button x:Name="WifiScanButton" Style="{StaticResource XboxRow}" FontSize="15" Padding="16,9"
                                            Margin="0,12,0,0" Click="OnWifiScanClick"><TextBlock Text="Scan again"/></Button>
                                    <Button x:Name="WifiDisconnectButton" Style="{StaticResource XboxRow}" FontSize="15" Padding="16,9"
                                            Margin="0,8,0,0" Click="OnWifiDisconnectClick"><TextBlock Text="Disconnect Wi-Fi"/></Button>
                                    <Button x:Name="WifiSettingsButton" Style="{StaticResource XboxRow}" FontSize="15" Padding="16,9"
                                            Margin="0,8,0,0" Click="OnWifiSettingsClick"><TextBlock Text="Open Windows network settings"/></Button>
                                </StackPanel>

                                <StackPanel x:Name="WifiPasswordPanel" Visibility="Collapsed">
                                    <TextBlock x:Name="WifiPasswordLabel" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBox x:Name="WifiPasswordBox" Style="{StaticResource FieldBox}" MaxLength="63"/>
                                    <TextBlock Text="A opens the on-screen keyboard. Leave it empty for an open network (no password)."
                                               FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{DynamicResource TextMuted}"/>
                                    <Button Style="{StaticResource XboxRow}" FontSize="15" Padding="16,9"
                                            Click="OnWifiPasswordConnectClick"><TextBlock Text="Connect"/></Button>
                                    <Button Style="{StaticResource XboxRow}" FontSize="15" Padding="16,9" Margin="0,8,0,0"
                                            Click="OnWifiPasswordCancelClick"><TextBlock Text="Cancel"/></Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== Power menu: Sleep / Restart / Shut down (button next to the clock, or Select) ===== -->
                <Grid x:Name="PowerPanel" Visibility="Collapsed"
                      KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle">
                    <Rectangle Fill="#CC000000" MouseLeftButtonUp="OnPowerDimClick"/>
                    <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,4,0,0" Padding="36,30">
                        <StackPanel>
                            <TextBlock x:Name="PowerTitle" Text="Power" FontSize="34" FontWeight="Light"/>
                            <TextBlock x:Name="PowerSubtitle" Text="What should the PC do?" FontSize="14" TextWrapping="Wrap"
                                       Margin="0,6,0,18" Foreground="{DynamicResource TextMuted}"/>

                            <StackPanel x:Name="PowerMain">
                                <Button x:Name="PowerSleepButton" Style="{StaticResource XboxRow}" Width="364" Margin="0,0,0,10"
                                        Tag="Sleep" Click="OnPowerChoiceClick"><TextBlock Text="Sleep"/></Button>
                                <Button x:Name="PowerRestartButton" Style="{StaticResource XboxRow}" Width="364" Margin="0,0,0,10"
                                        Tag="Restart" Click="OnPowerChoiceClick"><TextBlock Text="Restart"/></Button>
                                <Button x:Name="PowerShutdownButton" Style="{StaticResource XboxRow}" Width="364" Margin="0,0,0,10"
                                        Tag="ShutDown" Click="OnPowerChoiceClick"><TextBlock Text="Shut down"/></Button>
                                <Button x:Name="PowerCancelButton" Style="{StaticResource XboxRow}" Width="364" Margin="0,10,0,0"
                                        Click="OnPowerCancelClick"><TextBlock Text="Cancel"/></Button>
                            </StackPanel>

                            <StackPanel x:Name="PowerConfirm" Visibility="Collapsed">
                                <Button x:Name="PowerConfirmButton" Style="{StaticResource XboxRow}" Width="364" Margin="0,0,0,10"
                                        Click="OnPowerConfirmClick"><TextBlock x:Name="PowerConfirmLabel"/></Button>
                                <Button x:Name="PowerConfirmCancelButton" Style="{StaticResource XboxRow}" Width="364" Margin="0,0,0,0"
                                        Click="OnPowerBackClick"><TextBlock Text="Cancel"/></Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- ===== Launch overlay: covers the launcher from launch until the game closes ===== -->
        <Grid x:Name="LaunchOverlay" Visibility="Collapsed" Opacity="0">
            <Image x:Name="OverlayBackdrop" Stretch="UniformToFill" Opacity="0.6" IsHitTestVisible="False"/>
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FA000000" Offset="0"/>
                        <GradientStop Color="#D9000000" Offset="0.5"/>
                        <GradientStop Color="#40000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Viewbox Stretch="Uniform">
                <Grid Width="1280" Height="720">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="120,0,0,24">
                        <Border Width="210" Height="315" Background="{DynamicResource Surface}" VerticalAlignment="Center"
                                BorderBrush="#55FFFFFF" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="OverlayInitial" FontSize="60" FontWeight="Light"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="OverlayCover" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="52,0,0,0" VerticalAlignment="Center" Width="640">
                            <TextBlock x:Name="OverlaySource" Text="LITELAUNCHER · STEAM"
                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            <TextBlock x:Name="OverlayTitle" Margin="0,8,0,0" FontSize="54" FontWeight="Light"
                                       TextWrapping="Wrap" MaxHeight="140"/>
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Grid Width="28" Height="28" VerticalAlignment="Center">
                                    <Ellipse x:Name="OverlaySpinner" Stroke="{DynamicResource Accent}" StrokeThickness="3"
                                             StrokeDashArray="5 3" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="OverlaySpin"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <TextBlock x:Name="OverlayStatus" Margin="16,0,0,0" VerticalAlignment="Center"
                                           FontSize="20" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <Border Width="520" Height="4" Margin="0,16,0,0" HorizontalAlignment="Left" Background="#33FFFFFF">
                                <Border x:Name="OverlayProgress" HorizontalAlignment="Left" Width="0"
                                        Background="{DynamicResource Accent}"/>
                            </Border>
                            <TextBlock x:Name="OverlayHint" Margin="0,14,0,0" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                                <Button x:Name="OverlayCancelButton" Style="{StaticResource XboxButton}"
                                        Margin="0,0,12,0" Click="OnOverlayCancelClick">
                                    <TextBlock x:Name="OverlayCancelLabel" Text="B   ✕  Cancel launch"/>
                                </Button>
                                <Button x:Name="OverlayResumeButton" Style="{StaticResource XboxPrimary}"
                                        Margin="0,0,12,0" Visibility="Collapsed" Click="OnOverlayResumeClick">
                                    <TextBlock Text="A   ▶  Back to game"/>
                                </Button>
                                <Button x:Name="OverlayHomeButton" Style="{StaticResource XboxButton}"
                                        Margin="0,0,0,0" Visibility="Collapsed" Click="OnOverlayHomeClick">
                                    <TextBlock x:Name="OverlayHomeLabel" Text="⌂  Home"/>
                                </Button>
                                <Button x:Name="OverlayForceButton" Style="{StaticResource XboxButton}"
                                        Margin="12,0,0,0" Visibility="Collapsed" Click="OnOverlayForceClick">
                                    <TextBlock x:Name="OverlayForceLabel" Text="A   ⏻  Force close game"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
