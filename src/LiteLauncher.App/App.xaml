<Application x:Class="LiteLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme tokens. ThemeManager replaces these at runtime, so everything uses DynamicResource. -->
            <Color x:Key="AccentColor">#4C9AFF</Color>
            <Color x:Key="BgColor">#0F1115</Color>
            <SolidColorBrush x:Key="Accent" Color="#4C9AFF"/>
            <SolidColorBrush x:Key="Bg" Color="#0F1115"/>
            <SolidColorBrush x:Key="Surface" Color="#2A2D33"/>
            <SolidColorBrush x:Key="SurfaceHi" Color="#383C44"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#F2F4F8"/>
            <SolidColorBrush x:Key="TextMuted" Color="#A3ABBB"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
